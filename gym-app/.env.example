# Copy to .env and fill in. Both values are on your Supabase dashboard under
# Project Settings -> API. Use the anon / publishable key ONLY.
# Never put the service_role / secret key here: everything prefixed EXPO_PUBLIC_ is
# readable by anyone who downloads the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Shown on the sign-up screen when both are set.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Optional. Turns on the Stripe upgrade buttons in the web build once the
# billing functions are deployed (see README).
EXPO_PUBLIC_BILLING_ENABLED=false
EXPO_PUBLIC_PRO_PRICE_LABEL=
